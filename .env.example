# Copiez ce fichier en ".env" et ajustez les valeurs pour votre environnement.

SECRET_KEY=change-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Africa/Casablanca
DEFAULT_CURRENCY=MAD

# Base de donnees : "sqlite" (par defaut, pour le developpement) ou "postgres"
DB_ENGINE=sqlite
DB_NAME=ayden_transit
DB_USER=ayden_transit
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
