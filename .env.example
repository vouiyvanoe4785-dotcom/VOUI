# Copiez ce fichier en ".env" et ajustez les valeurs pour votre environnement.

SECRET_KEY=change-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

TIME_ZONE=Africa/Casablanca
DEFAULT_CURRENCY=MAD

# Base de donnees : "sqlite" (par defaut, pour le developpement) ou "postgres"
DB_ENGINE=sqlite
DB_NAME=ayden_transit
DB_USER=ayden_transit
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Alertes (en jours)
ALERTE_DOSSIER_INACTIF_JOURS=7
ALERTE_FACTURE_RETARD_CRITIQUE_JOURS=30
ALERTE_ECHEANCE_PROCHE_JOURS=3
ALERTE_REPONSE_DEVIS_JOURS=7

# Adresse publique (liens du récapitulatif e-mail des alertes)
SITE_URL=https://transit.votre-domaine.ma

# Production derrière Nginx : préfixe de la location "internal" qui sert MEDIA_ROOT (voir README)
PROTECTED_MEDIA_ACCEL_PREFIX=

# E-mail (mot de passe oublié). En dev, laisser vide : les e-mails s'affichent dans la console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ayden Transit <no-reply@votre-domaine.ma>

# Production derrière Nginx en HTTPS (liens https:// dans les e-mails)
BEHIND_HTTPS_PROXY=False
